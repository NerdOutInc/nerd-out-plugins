{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/bridge/recall-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/journal-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/bridge/recall-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/journal-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
