{
  "tools": [
    {
      "name": "get_project_context",
      "inputSchema": {
        "type": "object",
        "properties": {
          "activityCursor": {
            "type": "string",
            "maxLength": 1024
          },
          "activityLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "projectUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["projectUuid"]
      }
    },
    {
      "name": "list_note_activity",
      "inputSchema": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string" },
          "limit": { "type": "integer", "maximum": 50 },
          "cursor": { "type": "string" }
        },
        "required": ["uuid"]
      }
    }
  ]
}
